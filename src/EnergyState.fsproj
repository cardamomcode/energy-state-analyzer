<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <!-- Fable is the transpiler of record; the .NET target is only for type-checking and
         for Fable to resolve F# sources. No .NET executable is ever produced from this project. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- F# SDK: EnableDefaultCompileItems is false, so every source file must be listed. -->
    <Compile Include="Core/Hello.fs" />
    <Compile Include="Core/TreeSitter.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.2.0" />
  </ItemGroup>
</Project>

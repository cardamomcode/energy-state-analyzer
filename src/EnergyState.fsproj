<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <!-- Fable is the transpiler of record; the .NET target is only for type-checking and
         for Fable to resolve F# sources. No .NET executable is ever produced from this project. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- F# SDK: EnableDefaultCompileItems is false, so every source file must be listed.
         Order matters: dependencies first (TreeSitter facade before the modules that read it). -->
    <Compile Include="Core/Hello.fs" />
    <Compile Include="Core/TreeSitter.fs" />
    <Compile Include="Core/Violation.fs" />
    <Compile Include="Core/Position.fs" />
    <Compile Include="Core/LanguageAdapter.fs" />
    <Compile Include="Core/Context.fs" />
    <Compile Include="Languages/Python.fs" />
    <Compile Include="Languages/TypeScript.fs" />
    <Compile Include="Languages/FSharp.fs" />
    <Compile Include="Languages/Kotlin.fs" />
    <Compile Include="Core/Detectors/Nesting.fs" />
    <Compile Include="Core/Detectors/Cyclomatic.fs" />
    <Compile Include="Core/Detectors/Cognitive.fs" />
    <Compile Include="Core/Analyze.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.2.0" />
  </ItemGroup>
</Project>
